# ═══════════════════════════════════════════════════════════════════════════════
# GLYPHERE FRONTEND — HOSTINGER & LITESPEED HARDENED CONFIGURATION (.htaccess)
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Disable directory indexing (prevents browsing folder file lists)
Options -Indexes

# 2. Font MIME Types
AddType font/woff2 .woff2
AddType font/woff .woff
AddType font/ttf .ttf
AddType font/otf .otf

# 3. Safe Cross-Origin & Security Headers (100% LiteSpeed / Apache compatible)
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# 4. Strict Security: Block access to hidden files and sensitive file extensions
<IfModule mod_authz_core.c>
    # Block .env, .git, .vscode, etc.
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>
    # Block sensitive development & source files
    <FilesMatch "\.(env|log|md|lock|json|glyphs|ufo|sfd|vfb|py|sh|bak|sql)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.|\.(env|log|md|lock|json|glyphs|ufo|sfd|vfb|py|sh|bak|sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# 5. Route API endpoints to PHP bridge handlers on Hostinger
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/create-checkout-session/?$ api/create-checkout-session.php [L,QSA]
    RewriteRule ^api/get-checkout-session/?$ api/get-checkout-session.php [L,QSA]
    RewriteRule ^api/download-font/?$ api/download-font.php [L,QSA]
</IfModule>
