# ═══════════════════════════════════════════════════════════════════════════════
# GLYPHERE BACKEND PROTECTION (.htaccess)
# Strictly block all direct HTTP / public web browser access to this folder
# ═══════════════════════════════════════════════════════════════════════════════

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
