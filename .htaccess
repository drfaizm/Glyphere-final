# ═══════════════════════════════════════════════════════════════════════════════
# GLYPHERE ROOT SECURITY CONFIGURATION (.htaccess)
# Strictly protects private directories at domain root
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Disable directory indexing
Options -Indexes

# 2. Safe Cross-Origin & Security Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# 3. Strict Security: Forbid browser access to private folders, .env, and sensitive files
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct browser access to private folders
    RewriteRule ^backend(/.*)?$ - [F,L]
    RewriteRule ^font-vault(/.*)?$ - [F,L]
    RewriteRule ^Font\ Vault(/.*)?$ - [F,L]
    RewriteRule ^login-auth(/.*)?$ - [F,L]
    RewriteRule ^docs(/.*)?$ - [F,L]
    RewriteRule ^commercial-vault(/.*)?$ - [F,L]
    RewriteRule ^\.env.*$ - [F,L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^\.|\.(env|log|md|lock|json|glyphs|ufo|sfd|vfb|py|sh|bak|sql)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.|\.(env|log|md|lock|json|glyphs|ufo|sfd|vfb|py|sh|bak|sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
