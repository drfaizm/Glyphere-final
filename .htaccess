# ═══════════════════════════════════════════════════════════════════════════════
# GLYPHERE ROOT CONFIGURATION & HARDENED SECURITY (.htaccess)
# ═══════════════════════════════════════════════════════════════════════════════

# 1. Disable directory indexing
Options -Indexes

# 2. Font MIME Types
AddType font/woff2 .woff2
AddType font/woff .woff
AddType font/ttf .ttf
AddType font/otf .otf

# 3. Safe Cross-Origin & Security Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# 4. Strict Security: Forbid access to backend/, Font Vault/, .env, and sensitive files
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Deny direct browser access to backend and Font Vault folders
    RewriteRule ^backend(/.*)?$ - [F,L]
    RewriteRule ^Font\ Vault(/.*)?$ - [F,L]
    RewriteRule ^commercial-vault(/.*)?$ - [F,L]
    RewriteRule ^\.env.*$ - [F,L]

    # Route root request to main-website homepage
    RewriteRule ^$ main-website/homepage.html [L]

    # Route top-level /api/* to main-website/api/*
    RewriteRule ^api/create-checkout-session/?$ main-website/api/create-checkout-session.php [L,QSA]
    RewriteRule ^api/get-checkout-session/?$ main-website/api/get-checkout-session.php [L,QSA]
    RewriteRule ^api/download-font/?$ main-website/api/download-font.php [L,QSA]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^\.|\.(env|log|md|lock|json|glyphs|ufo|sfd|vfb|py|sh|bak|sql)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.|\.(env|log|md|lock|json|glyphs|ufo|sfd|vfb|py|sh|bak|sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
